# DAYON - Treino: config do app Web do Firebase (projeto dayon---treino).
# Copie para frontend/.env.local e preencha com o objeto de config do Console
# (Configurações do projeto > Seus apps > app Web). NUNCA faça commit do .env.local.
# Sem estes valores o app funciona normalmente no modo local; só o "Entrar na Dayon" fica indisponível.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dayon---treino.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dayon---treino
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
